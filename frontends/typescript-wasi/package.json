{
    "name": "@nyar/typescript",
    "version": "0.0.1",
    "description": "TypeScript WASI wrapper, providing TypeScript interface for TypeScript WASM functionality",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": ["dist"],
    "scripts": {
        "build": "rimraf dist && tsc --emitDeclarationOnly && vite build && npx --no-install jco transpile ../../target/wasm32-wasip2/release/typescript_wasi.wasm --out-dir dist --name typescriptWasi && node -e "const fs = require('fs'); const path = require('path'); const distDir = './dist'; const filesToKeep = ['index.js', 'index.d.ts', 'typescriptWasi.core.wasm', 'typescriptWasi.js', 'typescriptWasi.d.ts']; fs.readdirSync(distDir).forEach(file => { const fullPath = path.join(distDir, file); if (!filesToKeep.includes(file)) { if (fs.lstatSync(fullPath).isDirectory()) { fs.rmSync(fullPath, { recursive: true, force: true }); } else { fs.unlinkSync(fullPath); } } }); console.log('Cleaned up unnecessary files in dist directory');"",
        "dev": "tsc --watch",
        "test": "vitest"
    },
    "keywords": ["typescript", "wasm", "wasi", "rust", "compiler"],
    "author": "Nyar",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.19.37",
        "rimraf": "^6.0.0",
        "terser": "^5.0.0",
        "typescript": "^5.0.0",
        "vite": "^5.0.0",
        "vitest": "^1.0.0"
    }
}
