{
    "name": "@nyar/typescript",
    "version": "0.0.1",
    "description": "TypeScript WASI wrapper, providing TypeScript interface for TypeScript WASM functionality",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": ["dist"],
    "scripts": {
        "build": "rimraf dist && tsc && vite build",
        "dev": "tsc --watch",
        "test": "vitest"
    },
    "keywords": ["typescript", "wasm", "wasi", "rust", "compiler"],
    "author": "Nyar",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.19.37",
        "mkdirp": "^3.0.0",
        "rimraf": "^6.0.0",
        "terser": "^5.0.0",
        "typescript": "^5.0.0",
        "vite": "^5.0.0",
        "vitest": "^1.0.0"
    }
}
