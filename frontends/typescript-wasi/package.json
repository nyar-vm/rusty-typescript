{
    "name": "@nyar/typescript",
    "version": "0.1.0",
    "description": "TypeScript WASI 包装层，提供对 TypeScript WASM 功能的 TypeScript 接口",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "lib"
    ],
    "scripts": {
        "build": "tsc && npx --no-install jco transpile ../../target/wasm32-wasip2/release/typescript_wasi.wasm --out-dir lib --name typescriptWasi",
        "dev": "tsc --watch"
    },
    "keywords": [
        "typescript",
        "wasm",
        "wasi",
        "rust",
        "compiler"
    ],
    "author": "Nyar",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.19.37",
        "typescript": "^5.0.0"
    }
}
